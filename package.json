{
  "name": "sjlab-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sjlab-prod --local",
    "db:migrate:prod": "wrangler d1 migrations apply sjlab-prod --remote",
    "db:studio": "drizzle-kit studio",
    "preview": "opennextjs-cloudflare && wrangler pages dev",
    "deploy": "rm -rf .open-next && opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.1",
    "jspdf": "^4.2.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.95.0"
  }
}
